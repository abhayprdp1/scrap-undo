# Database
DATABASE_URL=postgresql://scrapconnect:scrapconnect_secret@localhost:5432/scrapconnect_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_this_to_a_random_secret_string
JWT_EXPIRES_IN=7d

# Gemini Vision API (Google AI Studio — free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# AWS S3 (for image storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=scrapconnect-images
AWS_REGION=ap-south-1

# App
PORT=3001
NODE_ENV=development

# OTP (use Twilio for production; mocked in dev)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
